 "claims": [
  {
   "claim": "Laboratory mice use a low-frequency call repertoire during physical separation.",
   "source": "Dataset title",
   "result": "3,147 accepted calls from 19 animals. 937 carry LFV labels (median peak 11.7 kHz); 2,210 are ultrasonic (median peak 53.3 kHz). LFV calls were present in 19 of 19 animals (share per animal: median 31%, range 8%\u201368%).",
   "status": "consistent, partly checked",
   "scope": "These tables contain the separation condition only, so they show that a low-frequency repertoire occurs during separation; they cannot show that it is specific to separation. That comparison needs the control recordings."
  }
